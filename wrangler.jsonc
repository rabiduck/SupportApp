{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supportapp",
  "main": "src/worker-v7.js",
  "compatibility_date": "2026-09-08",
  "vars": {
    "AUTH_PROVIDER": "local"
  },
  "assets": {
    "directory": "./public"
  },
  "triggers": {
    "crons": ["0 7 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "supportapp-uat",
      "database_id": "3217e771-a3ca-4f5d-99dc-47a525240ca8",
      "migrations_dir": "migrations"
    }
  ]
}
